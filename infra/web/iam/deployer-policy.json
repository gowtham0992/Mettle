{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UpdateOnlyMettleWebFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode"
      ],
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:mettle-web"
    },
    {
      "Sid": "ReadOnlyImmutableWebArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::mettle-agentcore-artifacts-123456789012-us-east-1/web/*"
    },
    {
      "Sid": "InspectOnlyMettleStaticBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::mettleweb-staticbucket-example"
    },
    {
      "Sid": "PublishOnlyMettleStaticAssets",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::mettleweb-staticbucket-example/*"
    },
    {
      "Sid": "InvalidateOnlyMettleDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetDistribution",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::123456789012:distribution/EXAMPLE123"
    },
    {
      "Sid": "InspectOnlyMettleWebReleaseLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/mettle-web",
        "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/mettle-web:log-stream:*"
      ]
    }
  ]
}
