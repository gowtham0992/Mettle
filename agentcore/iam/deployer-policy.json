{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedMettleRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:CreateAgentRuntime",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "Mettle"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "CreateDefaultEndpointForNewRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:CreateAgentRuntimeEndpoint",
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/*"
    },
    {
      "Sid": "ManageOnlyTaggedMettleRuntimes",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:DeleteAgentRuntime",
        "bedrock-agentcore:GetAgentRuntime",
        "bedrock-agentcore:InvokeAgentRuntime",
        "bedrock-agentcore:UpdateAgentRuntime"
      ],
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "Mettle"
        }
      }
    },
    {
      "Sid": "DeleteDefaultEndpointWithTaggedRuntime",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:DeleteAgentRuntimeEndpoint",
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/*"
    },
    {
      "Sid": "TagOnlyMettleRuntimes",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ListTagsForResource",
        "bedrock-agentcore:TagResource"
      ],
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/*"
    },
    {
      "Sid": "TagMettleManagedWorkloadIdentity",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:CreateWorkloadIdentity",
        "bedrock-agentcore:TagResource"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:123456789012:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:us-east-1:123456789012:workload-identity-directory/default/workload-identity/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "Mettle"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project"
          ]
        }
      }
    },
    {
      "Sid": "PassOnlyMettleRuntimeRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/MettleAgentCoreRuntime",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DeleteOnlyMettleManagedWorkloadIdentity",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:DeleteWorkloadIdentity",
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:123456789012:workload-identity-directory/default/workload-identity/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "Mettle"
        }
      }
    },
    {
      "Sid": "UseDefaultDirectoryForWorkloadIdentityDeletion",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:DeleteWorkloadIdentity",
      "Resource": "arn:aws:bedrock-agentcore:us-east-1:123456789012:workload-identity-directory/default"
    },
    {
      "Sid": "ListArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::mettle-agentcore-artifacts-123456789012-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": "runtime/*"
        }
      }
    },
    {
      "Sid": "ManageVersionedRuntimeArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::mettle-agentcore-artifacts-123456789012-us-east-1/runtime/*"
    }
  ]
}
